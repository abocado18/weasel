[
  {
    "label": "Configure Debug",
    "command": "cmake",
    "args": ["--preset", "Debug"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Configure Release",
    "command": "cmake",
    "args": ["--preset", "Release"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Build Debug",
    "command": "cmake",
    "args": ["--build", "--preset", "Debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "depends_on": "Configure Debug"
  },
  {
    "label": "Build Release",
    "command": "cmake",
    "args": ["--build", "--preset", "Release"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "depends_on": "Configure Release"
  }
]
